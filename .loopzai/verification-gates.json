{
  "artifactVersion": 1,
  "gates": [
    {
      "id": "typecheck",
      "kind": "exit-code",
      "cwd": "",
      "command": "npx",
      "args": ["tsc", "--noEmit"],
      "timeoutMs": 300000
    },
    {
      "id": "build",
      "kind": "exit-code",
      "cwd": "",
      "command": "npm",
      "args": ["run", "build"],
      "timeoutMs": 600000
    },
    {
      "id": "tests",
      "kind": "exit-code",
      "cwd": "",
      "command": "npm",
      "args": ["test"],
      "timeoutMs": 1800000
    }
  ]
}